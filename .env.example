# Postgres (Supabase en staging/producción — ver ADR-006; local via docker-compose)
# DATABASE_URL: rol de aplicación (sin superuser/BYPASSRLS) — es el único que usa shared/db.
# MIGRATIONS_DATABASE_URL: rol admin, solo usado por `npm run migrate` (puede saltarse RLS).
DATABASE_URL=postgres://agent_sale_app:agent_sale_app@localhost:5432/agent_sale
MIGRATIONS_DATABASE_URL=postgres://agent_sale:agent_sale@localhost:5432/agent_sale

# Redis (colas + cache de inventario — ver ADR-002/ADR-003; local via docker-compose)
REDIS_URL=redis://localhost:6379

# Claude (ver ADR-008) — sin cuenta real todavía; usar cualquier string
# para poder correr build/lint/test localmente (las llamadas reales a la
# API de Claude no se ejercitan en este incremento, ver plan).
ANTHROPIC_API_KEY=dev-only-fake-key

# Twilio / WhatsApp BSP (ver ADR-001) — cuenta real pendiente (Fase 3),
# pero todas estas variables son requeridas ya: el gateway y el
# orchestrator las necesitan para arrancar aunque todavía no haya una
# cuenta real registrando el webhook ni enviando mensajes.
TWILIO_AUTH_TOKEN=dev-only-fake-token
PUBLIC_WEBHOOK_URL=http://localhost:3000/webhooks/whatsapp
TWILIO_ACCOUNT_SID=dev-only-fake-sid
TWILIO_WHATSAPP_NUMBER=whatsapp:+10000000000

# App
PORT=3000
NODE_ENV=development
