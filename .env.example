# Postgres (Supabase en staging/producción — ver ADR-006; local via docker-compose)
# DATABASE_URL: rol de aplicación (sin superuser/BYPASSRLS) — es el único que usa shared/db.
# MIGRATIONS_DATABASE_URL: rol admin, solo usado por `npm run migrate` (puede saltarse RLS).
DATABASE_URL=postgres://agent_sale_app:agent_sale_app@localhost:5432/agent_sale
MIGRATIONS_DATABASE_URL=postgres://agent_sale:agent_sale@localhost:5432/agent_sale

# Redis (colas + cache de inventario — ver ADR-002/ADR-003; local via docker-compose)
REDIS_URL=redis://localhost:6379

# Proveedor de LLM (ver ADR-010). "anthropic" (default) usa Claude
# (ADR-008) y requiere ANTHROPIC_API_KEY. Para pruebas reales de bajo
# costo sin cuenta de Anthropic, cambiar a "openai_compatible" (DeepSeek
# por defecto) y comentar/descomentar las variables de abajo — no
# requiere tocar nada más del código.
LLM_PROVIDER=anthropic

# Claude (ver ADR-008) — sin cuenta real todavía; usar cualquier string
# para poder correr build/lint/test localmente (las llamadas reales a la
# API de Claude no se ejercitan en este incremento, ver plan).
ANTHROPIC_API_KEY=dev-only-fake-key

# Proveedor alternativo compatible con OpenAI (ver ADR-010) — solo se usa
# si LLM_PROVIDER=openai_compatible. Defaults ya apuntan a DeepSeek
# (https://api.deepseek.com, modelo deepseek-chat); para Groq/OpenAI/etc.
# ajustar LLM_BASE_URL y LLM_MODEL según el proveedor.
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=tu-api-key-real

# Clave maestra para cifrar las API keys que un tenant trae propias (BYOK,
# Fase 11.4 — ver docs/fase-11-panel-admin-dashboard/adrs/ADR-020-proveedor-modelo-configurable-byok.md).
# 32 bytes en base64 — generar con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TENANT_SECRETS_ENCRYPTION_KEY=

# Key de sistema para Gemini (ver catalog.ts) — opcional, Gemini nunca es
# el default de la plataforma. Sin esto, un tenant que elige Gemini debe
# traer su propia key (BYOK) en el panel de Configuración.
# GEMINI_API_KEY=

# Twilio / WhatsApp BSP (ver ADR-001) — cuenta real pendiente (Fase 3),
# pero todas estas variables son requeridas ya: el gateway y el
# orchestrator las necesitan para arrancar aunque todavía no haya una
# cuenta real registrando el webhook ni enviando mensajes.
TWILIO_AUTH_TOKEN=dev-only-fake-token
PUBLIC_WEBHOOK_URL=http://localhost:3000/webhooks/whatsapp
TWILIO_ACCOUNT_SID=dev-only-fake-sid
TWILIO_WHATSAPP_NUMBER=whatsapp:+10000000000

# App
PORT=3000
NODE_ENV=development

# Nivel de log de src/shared/observability/logger.ts (Fase 8) — "debug" es
# útil en desarrollo local, "info" es el nivel recomendado en producción.
LOG_LEVEL=info

# Observabilidad local (Fase 8, opcional — ver observability/README.md):
# credenciales de Grafana Cloud Loki para probar el envío de logs desde un
# agente local (Grafana Alloy, docker-compose.observability.yml). No las
# usa la app directamente, solo el contenedor de Alloy.
GRAFANA_CLOUD_LOKI_URL=
GRAFANA_CLOUD_LOKI_USER=
GRAFANA_CLOUD_LOKI_API_KEY=
