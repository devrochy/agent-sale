{
  "__inputs": [
    {
      "name": "DS_LOKI",
      "label": "Loki (Grafana Cloud)",
      "description": "Datasource de Loki de tu stack de Grafana Cloud — se elige al importar.",
      "type": "datasource",
      "pluginId": "loki"
    }
  ],
  "title": "agent-sale — Fase 8 (observabilidad)",
  "description": "Punto de partida basado en docs/fase-8-observabilidad-seguridad/tracing.md — consultas LogQL sobre los campos que ya emite src/shared/observability/logger.ts (event, tenant_id, conversation_id, latency_ms). Ajustar umbrales/paneles con datos reales del piloto.",
  "schemaVersion": 39,
  "timezone": "browser",
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Latencia total por turno (p50/p95) — criterio de Fase 0: < 30s",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "expr": "quantile_over_time(0.50, {app=\"agent-sale\"} | json | event=\"gateway.confirmacion_envio\" | unwrap total_latency_ms [$__interval])",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "quantile_over_time(0.95, {app=\"agent-sale\"} | json | event=\"gateway.confirmacion_envio\" | unwrap total_latency_ms [$__interval])",
          "legendFormat": "p95",
          "refId": "B"
        }
      ]
    },
    {
      "id": 2,
      "title": "Latencia de llamadas al LLM (p50/p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "expr": "quantile_over_time(0.50, {app=\"agent-sale\"} | json | event=\"orchestrator.llm_completado\" | unwrap latency_ms [$__interval])",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "quantile_over_time(0.95, {app=\"agent-sale\"} | json | event=\"orchestrator.llm_completado\" | unwrap latency_ms [$__interval])",
          "legendFormat": "p95",
          "refId": "B"
        }
      ]
    },
    {
      "id": 3,
      "title": "Latencia por tool (p95, por tool)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "expr": "quantile_over_time(0.95, {app=\"agent-sale\"} | json | event=\"orchestrator.tool_completada\" | unwrap latency_ms [$__interval]) by (tool)",
          "legendFormat": "{{tool}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Escalamientos a humano por motivo",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (reason) (count_over_time({app=\"agent-sale\"} | json | event=\"orchestrator.escalado\" [$__interval]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Tokens de entrada por tenant (proxy de costo — ver alertas-costo.md)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (tenant_id) (sum_over_time({app=\"agent-sale\"} | json | event=\"orchestrator.llm_completado\" | json input_tokens=\"usage.inputTokens\" | unwrap input_tokens [$__interval]))",
          "legendFormat": "{{tenant_id}}",
          "refId": "A"
        }
      ]
    }
  ]
}
